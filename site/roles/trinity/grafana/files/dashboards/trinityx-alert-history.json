        ]
      },
      "pluginVersion": "10.1.2",
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${history_ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  created_at AS record_time,\n  event_at AS event_time,\n  hostname,\n  alertname,\n  status,\n  alertmanager_state,\n  is_suppressed,\n  severity,\n  description,\n  value_text AS value,\n  job,\n  exporter,\n  source,\n  fingerprint\nFROM alert_history_events\nWHERE $__timeFilter(created_at)\n  AND ('${hostname:raw}' = 'All' OR hostname = '${hostname:raw}')\n  AND ('${severity:raw}' = 'All' OR severity = '${severity:raw}')\n  AND ('${alertname:raw}' = 'All' OR alertname = '${alertname:raw}')\n  AND ('${status:raw}' = 'All' OR status = '${status:raw}')\nORDER BY created_at DESC, id DESC\nLIMIT 5000",
          "refId": "A"
        }
      ],
      "title": "Alert history",
      "type": "table"
    }
