    {
      "id": 10,
      "type": "table",
      "title": "Worst ports by errors (link errors / failing: 1h, traffic loss: 15m)",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "errors (1h)"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "topk(20, label_replace(((sum by (guid, port) (increase(infiniband:link_degraded_total[1h])) > 0) * on (guid) group_left (hostname, hca) infiniband:hca_hostname:map) or ((sum by (guid, port) (increase(infiniband:link_degraded_total[1h])) > 0) * on (guid, port) group_left (switch, uplink, hostname) infiniband:switch_port_peer:map), \"class\", \"link errors\", \"\", \"\"))",
          "refId": "A",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "topk(20, label_replace(((sum by (guid, port) (increase(infiniband:link_failing_total[1h])) > 0) * on (guid) group_left (hostname, hca) infiniband:hca_hostname:map) or ((sum by (guid, port) (increase(infiniband:link_failing_total[1h])) > 0) * on (guid, port) group_left (switch, uplink, hostname) infiniband:switch_port_peer:map), \"class\", \"failing\", \"\", \"\"))",
          "refId": "B",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "expr": "topk(20, label_replace(((sum by (guid, port) (increase(infiniband:traffic_loss_total[15m])) > 0) * on (guid) group_left (hostname, hca) infiniband:hca_hostname:map) or ((sum by (guid, port) (increase(infiniband:traffic_loss_total[15m])) > 0) * on (guid, port) group_left (switch, uplink, hostname) infiniband:switch_port_peer:map), \"class\", \"traffic loss\", \"\", \"\"))",
          "refId": "C",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "hca": true,
              "uplink": true
            },
            "indexByName": {
              "class": 0,
              "hostname": 1,
              "switch": 2,
              "port": 3,
              "guid": 4,
              "Value #A": 5,
              "Value #B": 6,
              "Value #C": 7
            },
            "renameByName": {
              "Value #A": "errors (1h)",
              "Value #B": "fail events (1h)",
              "Value #C": "discards (15m)",
              "class": "class",
              "hostname": "node",
              "switch": "switch",
              "port": "port"
            }
          }
        }
      ]
    },
