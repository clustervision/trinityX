# The luna and trixd PAM services reach only this domain: the controller's users, without
# the login filter, their account expiry still checked.
[sssd]
# an application domain is used only when listed here as well
domains = controller, luna

[pam]
# one list for every PAM service on this controller; add a service here, not in its own file
pam_app_services = trixd, luna

[application/luna]
inherit_from = controller
ldap_access_order = expire
enumerate = false
