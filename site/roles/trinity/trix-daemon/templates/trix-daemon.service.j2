# Generated by ansible

[Unit]
Description = TrinityX trix-daemon
After = network-online.target
Wants = network-online.target

[Service]
Type = simple
WorkingDirectory = {{ trixd_root }}
ExecStart = {{ trix_local }}/python/bin/python3 -m trix.server --config {{ trixd_config_dir }}/trixd.ini
ExecReload = /bin/kill -s HUP $MAINPID
Restart = on-failure
RestartSec = 5
RuntimeDirectory = trix
StandardOutput = journal
StandardError = journal

[Install]
WantedBy = multi-user.target
