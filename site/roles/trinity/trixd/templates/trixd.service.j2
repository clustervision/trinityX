# Generated by ansible

[Unit]
Description = TrinityX trixd
After = network-online.target
Wants = network-online.target

[Service]
Type = simple
WorkingDirectory = {{ trixd_root }}
Environment = TRIXD_LUNA_INI={{ trixd_luna_ini }}
ExecStart = {{ trix_local }}/python/bin/python3 -m trixd.server --config {{ trixd_config_dir }}/trixd.ini
ExecReload = /bin/kill -s HUP $MAINPID
Restart = on-failure
RestartSec = 5
RuntimeDirectory = trixd
StandardOutput = journal
StandardError = journal

[Install]
WantedBy = multi-user.target
