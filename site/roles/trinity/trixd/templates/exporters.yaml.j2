# Generated by ansible
# The controllers' exporters, as the exporter roles wrote them for Prometheus. No nodes
# section on purpose: an empty one would scrape no node at all, while leaving it out keeps
# the node exporters built into trixd.
{% set found = namespace(controllers={}, hosts={}) %}
{% for read in trixd_controller_sd.results %}
{% for entry in read.content | b64decode | from_yaml or [] %}
{% for target in entry.targets %}
{% set address, port = target.rsplit(':', 1) %}
{% set _ = found.controllers.update({entry.labels.exporter: {'port': port | int}}) %}
{% set _ = found.hosts.update({entry.labels.hostname: {'address': address}}) %}
{% endfor %}
{% endfor %}
{% endfor %}
{{ {'controllers': found.controllers, 'hosts': found.hosts} | to_nice_yaml(indent=2) }}
