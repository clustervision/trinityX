#!/bin/bash
# node-console-setup.sh — deployed by trinity/node-console into the compute image.
# Runs at boot via node-console-setup.service to load the netconsole kernel module
# with correct runtime IP/interface parameters.
#
# This code is part of the TrinityX software suite
# Copyright (C) 2025  ClusterVision Solutions b.v.  — License: GPL v3 or later

CTRL_IP="{{ netconsole_ctrl_ip }}"
CTRL_MAC="{{ netconsole_ctrl_mac }}"
NETCONSOLE_PORT="{{ netconsole_port }}"
ROUTE_WAIT_TIMEOUT="{{ netconsole_route_wait_timeout }}"

# Wait for a usable route to the controller (race at boot after network-online.target)
ROUTE_INFO=""
IFACE=""
NODE_IP=""
DEADLINE=$(( $(date +%s) + ROUTE_WAIT_TIMEOUT ))

echo "netconsole-setup: waiting up to ${ROUTE_WAIT_TIMEOUT}s for route to ${CTRL_IP}"

while true; do
    ROUTE_INFO=$(ip route get "${CTRL_IP}" 2>/dev/null || true)
    if [ -n "${ROUTE_INFO}" ]; then
        IFACE=$(echo "${ROUTE_INFO}"  | awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}' | head -1)
        NODE_IP=$(echo "${ROUTE_INFO}" | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}' | head -1)
        if [ -n "${IFACE}" ] && [ -n "${NODE_IP}" ]; then
            break
        fi
    fi

    if [ "$(date +%s)" -ge "${DEADLINE}" ]; then
        echo "netconsole-setup: ERROR - no route to ${CTRL_IP} after ${ROUTE_WAIT_TIMEOUT}s" >&2
        [ -n "${ROUTE_INFO}" ] && echo "netconsole-setup: last route: ${ROUTE_INFO}" >&2
        exit 1
    fi

    sleep 1
done

echo "netconsole-setup: iface=${IFACE} node_ip=${NODE_IP} ctrl_ip=${CTRL_IP} ctrl_mac=${CTRL_MAC} port=${NETCONSOLE_PORT}"

# Load netconsole: [src-port]@[src-ip]/[dev],[tgt-port]@<tgt-ip>/[tgt-mac]
PARAMS="${NETCONSOLE_PORT}@${NODE_IP}/${IFACE},${NETCONSOLE_PORT}@${CTRL_IP}/${CTRL_MAC}"

if lsmod | grep -q "^netconsole "; then
    rmmod netconsole 2>/dev/null || true
fi

modprobe netconsole "netconsole=${PARAMS}"
RC=$?

if [ ${RC} -eq 0 ]; then
    echo "netconsole-setup: loaded (${PARAMS})"
    if [ -w /dev/kmsg ]; then
        printf '<6>{{ netconsole_ready_marker }} interface=%s node_ip=%s ctrl_ip=%s port=%s\n' \
            "${IFACE}" "${NODE_IP}" "${CTRL_IP}" "${NETCONSOLE_PORT}" > /dev/kmsg || true
    fi
else
    echo "netconsole-setup: ERROR - modprobe returned ${RC}" >&2
    exit ${RC}
fi
