#!/bin/bash
# trinity-booted-notify — deployed into the compute image by trinity/node-console.
#
# Fires once at first boot after provisioning: tells Luna the node's real OS is up
# by POSTing state "booted" to /monitor/node/<node>, then removes its one-shot
# credential so it never repeats.
#
# The credential file is written into the installed root by the Luna install script
# (templ_install.cfg) at provision time; it carries the node-scoped provision token
# (valid ~60 min — comfortably covers the first boot).
#
# ponytail: first-boot-only by design. Re-confirming "booted" on every reboot would
# need a durable per-node credential (key management) for near-zero benefit — add that
# only if operations actually require per-reboot liveness beyond lcluster's IPMI+SLURM.
#
# This code is part of the TrinityX software suite
# Copyright (C) 2025  ClusterVision Solutions b.v.  — License: GPL v3 or later

set -u

ENV_FILE="{{ booted_notify_env }}"

# No credential -> nothing to do: already reported (file self-deleted), or this image
# was booted outside a Luna provisioning cycle. Safe no-op.
[ -r "${ENV_FILE}" ] || exit 0

# shellcheck disable=SC1090
. "${ENV_FILE}"

: "${LUNA_URL:?booted-notify: LUNA_URL missing in ${ENV_FILE}}"
: "${NODE_NAME:?booted-notify: NODE_NAME missing in ${ENV_FILE}}"
: "${LUNA_TOKEN:?booted-notify: LUNA_TOKEN missing in ${ENV_FILE}}"

# Mirror the installer: only skip TLS verification when explicitly told to.
INSECURE=""
case "${VERIFY_CERTIFICATE:-}" in
    [Ff]alse|[Nn][Oo]) INSECURE="--insecure" ;;
esac

json='{"monitor": {"status": {"'"${NODE_NAME}"'": {"state": "booted"}}}}'

if curl ${INSECURE} -X POST \
        -H "x-access-tokens: ${LUNA_TOKEN}" \
        -H "Content-Type: application/json" \
        -d "${json}" -fsS --max-time 15 \
        "${LUNA_URL}/monitor/node/${NODE_NAME}"; then
    echo "booted-notify: reported 'booted' for ${NODE_NAME} to ${LUNA_URL}"
    rm -f "${ENV_FILE}"
else
    # Keep the credential so systemd can retry on the next boot, while the token lives.
    echo "booted-notify: failed to report 'booted' for ${NODE_NAME}" >&2
    exit 1
fi
