[Unit]
Description=TrinityX: report "booted" state to Luna after provisioning
After=network-online.target
Wants=network-online.target
# Skip entirely once the one-shot credential is gone (i.e. already reported).
ConditionPathExists={{ booted_notify_env }}

[Service]
Type=oneshot
ExecStart={{ booted_notify_script }}
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
