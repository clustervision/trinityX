groups:
- name: gpu_metrics_amd
  rules:
    # Basic GPU info ‐ add vendor label
    - record: gpu_info
      expr: |
        label_replace(
          rocm_smi_device_info,
          "name",
          "$1",
          "device_name",
          "(.*)"
        )
      labels:
        vendor: "AMD"

    # GPU utilisation (percent → ratio)
    - record: gpu_utilization_gpu_ratio
      expr: rocm_smi_utilization_gpu_percent / 100

    - record: gpu_utilization_memory_ratio
      expr: rocm_smi_utilization_memory_percent / 100

    # GPU temperature (junction)
    - record: gpu_temperature_gpu
      expr: rocm_smi_temperature_junction_celsius

    # Graphics clock (MHz → Hz)
    - record: gpu_clocks_current_graphics_clock_hz
      expr: rocm_smi_current_gfxclk_mhz * 1000000

    # Memory clock (uclk) (MHz → Hz)
    - record: gpu_clocks_current_memory_clock_hz
      expr: rocm_smi_current_uclk_mhz * 1000000

    # Power draw (watts)
    - record: gpu_power_draw_watts
      expr: rocm_smi_current_power_watts

    # Power default/limit (use max_power as proxy)
    - record: gpu_power_default_limit_watts
      expr: rocm_smi_max_power_watts

    # SM/SOC clock (MHz → Hz)
    - record: gpu_clocks_current_sm_clock_hz
      expr: rocm_smi_current_socclk_mhz * 1000000

- name: gpu_metrics_nvidia
  rules:
    # Basic GPU info ‐ add vendor label
    - record: gpu_info
      expr: nvidia_smi_gpu_info
      labels:
        vendor: "NVIDIA"

    # GPU P‐state
    - record: gpu_pstate
      expr: nvidia_smi_pstate

    # GPU utilisation (ratio already)
    - record: gpu_utilization_gpu_ratio
      expr: nvidia_smi_utilization_gpu_ratio

    - record: gpu_utilization_memory_ratio
      expr: nvidia_smi_utilization_memory_ratio

    # GPU temperature (core)
    - record: gpu_temperature_gpu
      expr: nvidia_smi_temperature_gpu

    # Clocks throttle reasons
    - record: gpu_clocks_throttle_reasons_gpu_idle
      expr: nvidia_smi_clocks_throttle_reasons_gpu_idle

    - record: gpu_clocks_throttle_reasons_hw_thermal_slowdown
      expr: nvidia_smi_clocks_throttle_reasons_hw_thermal_slowdown

    - record: gpu_clocks_throttle_reasons_sw_power_cap
      expr: nvidia_smi_clocks_throttle_reasons_sw_power_cap

    - record: gpu_clocks_throttle_reasons_applications_clocks_setting
      expr: nvidia_smi_clocks_throttle_reasons_applications_clocks_setting

    - record: gpu_clocks_throttle_reasons_hw_power_brake_slowdown
      expr: nvidia_smi_clocks_throttle_reasons_hw_power_brake_slowdown

    - record: gpu_clocks_throttle_reasons_sw_thermal_slowdown
      expr: nvidia_smi_clocks_throttle_reasons_sw_thermal_slowdown

    - record: gpu_clocks_throttle_reasons_sync_boost
      expr: nvidia_smi_clocks_throttle_reasons_sync_boost

    # Graphics clock (Hz)
    - record: gpu_clocks_current_graphics_clock_hz
      expr: nvidia_smi_clocks_current_graphics_clock_hz

    # Max graphics clock (Hz)
    - record: gpu_clocks_max_graphics_clock_hz
      expr: nvidia_smi_clocks_max_graphics_clock_hz

    # Memory clock (Hz)
    - record: gpu_clocks_current_memory_clock_hz
      expr: nvidia_smi_clocks_current_memory_clock_hz

    # Max memory clock (Hz)
    - record: gpu_clocks_max_memory_clock_hz
      expr: nvidia_smi_clocks_max_memory_clock_hz

    # Fan speed ratio
    - record: gpu_fan_speed_ratio
      expr: nvidia_smi_fan_speed_ratio

    # Video clock (Hz)
    - record: gpu_clocks_current_video_clock_hz
      expr: nvidia_smi_clocks_current_video_clock_hz

    # Power draw (watts)
    - record: gpu_power_draw_watts
      expr: nvidia_smi_power_draw_watts

    # Power default/limit (watts)
    - record: gpu_power_default_limit_watts
      expr: nvidia_smi_power_default_limit_watts

    # Memory used (bytes)
    - record: gpu_memory_used_bytes
      expr: nvidia_smi_memory_used_bytes

    # Memory total (bytes)
    - record: gpu_memory_total_bytes
      expr: nvidia_smi_memory_total_bytes

    # SM clock (Hz)
    - record: gpu_clocks_current_sm_clock_hz
      expr: nvidia_smi_clocks_current_sm_clock_hz

- name: job_state
  rules:
    - record: slurm_job_info_latest
      expr: last_over_time(slurm_job_info[365d])

- name: cores
  rules:
  - record: node_cores
    expr: count by (hostname,luna_group) (count(node_cpu_seconds_total) without (mode)) 

  - record: node_gpus
    expr: |
      ( count by (hostname,luna_group) (nvidia_smi_name) + count by (hostname,luna_group) ( rocm_smi_device_info ) ) OR
      ( count by (hostname,luna_group) (nvidia_smi_name) ) OR
      ( count by (hostname,luna_group) (rocm_smi_device_info) )

- name: power_consumption
  rules:
  - record: power_consumption_watts
    expr: sum by (hostname,luna_group) (ipmi_dcmi_power_consumption_watts) 
  
  - record: power_consumption_cpu_watts
    expr: |
      ( power_consumption_watts - sum by (hostname,luna_group) (nvidia_smi_power_draw_watts) - sum by (hostname,luna_group) (rocm_smi_current_power_watts) ) OR
      ( power_consumption_watts - sum by (hostname,luna_group) (nvidia_smi_power_draw_watts) ) OR
      ( power_consumption_watts - sum by (hostname,luna_group) (rocm_smi_current_power_watts) ) OR
      power_consumption_watts

  - record: power_consumption_gpu_watts
    expr: |
      ( sum by (hostname,luna_group) (nvidia_smi_power_draw_watts) + sum by (hostname,luna_group) (rocm_smi_current_power_watts) ) OR
      ( sum by (hostname,luna_group) (nvidia_smi_power_draw_watts) ) OR
      ( sum by (hostname,luna_group) (rocm_smi_current_power_watts) )

- name: power_consumption_per_unit
  rules:
  - record: power_consumption_per_cpu_watts
    expr: power_consumption_cpu_watts / node_cores

  - record: power_consumption_per_gpu_watts
    expr: power_consumption_gpu_watts / node_gpus

- name: infiniband_hostname_mapping
  rules:
    # Infiniband counters only carry {guid, port}; these maps let alert
    # rules join the hostname (TRIX-1655). The hca/uplink labels hold the
    # ibnetdiscover NodeDescription ("<hostname> mlx5_0"), whose first token
    # is whatever the node's uname -n was when the HCA came up - short on
    # some clusters, the FQDN on others. Luna is the authority on a node's
    # name, so the two sides are matched on the part before the first dot,
    # which is independent of the cluster's domain however many dots it has,
    # and the name luna knows is the one that comes out. Taking the fabric's
    # token verbatim instead fails silently: the alert still fires, but its
    # hostname matches nothing else in the stack and no join reports that.
    - record: infiniband:hca_luna_hostname:map
      expr: |
        max by (guid, hca, hostname) (
          label_replace(
            max by (guid, hca) (infiniband_hca_info),
            "shortname", "$1", "hca", "^([^ .]+).*"
          )
          * on (shortname) group_left (hostname)
          label_replace(
            max by (hostname) (up{job=~"luna_nodes|luna_controllers"}),
            "shortname", "$1", "hostname", "^([^.]+).*"
          )
        )

    # Controllers are part of the authority set above, so their HCAs are
    # named by luna too. Endpoints luna knows nothing about - a login node, a
    # host on a shared fabric - keep the name the fabric reports, unchanged
    # from the behaviour before this join existed. device is the
    # NodeDescription with the hostname removed ("mlx5_0"), so alert text can
    # name the port without repeating the node.
    - record: infiniband:hca_hostname:map
      expr: |
        label_replace(
          infiniband:hca_luna_hostname:map,
          "device", "$1", "hca", "^[^ ]+ +(.*)$"
        )
        or
        (
          label_replace(
            label_replace(
              max by (guid, hca) (infiniband_hca_info),
              "hostname", "$1", "hca", "^([^ ]+).*"
            ),
            "device", "$1", "hca", "^[^ ]+ +(.*)$"
          )
          unless on (guid) infiniband:hca_luna_hostname:map
        )

    # Switch port -> connected peer. Ports facing a HCA get the node
    # hostname, anchored on luna the same way; inter-switch links keep only
    # the peer name in the uplink label.
    - record: infiniband:switch_luna_peer:map
      expr: |
        max by (guid, port, switch, uplink, hostname) (
          label_replace(
            max by (guid, port, switch, uplink) (infiniband_switch_uplink_info{uplink_type="CA"}),
            "shortname", "$1", "uplink", "^([^ .]+).*"
          )
          * on (shortname) group_left (hostname)
          label_replace(
            max by (hostname) (up{job=~"luna_nodes|luna_controllers"}),
            "shortname", "$1", "hostname", "^([^.]+).*"
          )
        )

    - record: infiniband:switch_port_peer:map
      expr: |
        (
          infiniband:switch_luna_peer:map
          or
          (
            label_replace(
              max by (guid, port, switch, uplink) (infiniband_switch_uplink_info{uplink_type="CA"}),
              "hostname", "$1", "uplink", "^([^ ]+).*"
            )
            unless on (guid, port) infiniband:switch_luna_peer:map
          )
        )
        or
        max by (guid, port, switch, uplink) (infiniband_switch_uplink_info{uplink_type!="CA"})

    # Per-impact-class error totals (TRIX-1655). The alert rules need each
    # class as one series set, but increase() over a __name__ regex fails at
    # runtime once the metric name is dropped and label sets collide. The
    # label_replace tags every counter first, so the union stays distinct
    # and the alert rules can sum over it.
    - record: infiniband:link_degraded_total
      expr: |
        label_replace(infiniband_hca_port_symbol_error_total, "counter", "hca_symbol_error", "", "")
        or label_replace(infiniband_switch_port_symbol_error_total, "counter", "switch_symbol_error", "", "")
        or label_replace(infiniband_hca_port_receive_errors_total, "counter", "hca_receive_errors", "", "")
        or label_replace(infiniband_switch_port_receive_errors_total, "counter", "switch_receive_errors", "", "")
        or label_replace(infiniband_hca_port_link_error_recovery_total, "counter", "hca_link_error_recovery", "", "")
        or label_replace(infiniband_switch_port_link_error_recovery_total, "counter", "switch_link_error_recovery", "", "")
        or label_replace(infiniband_hca_port_excessive_buffer_overrun_errors_total, "counter", "hca_buffer_overrun", "", "")
        or label_replace(infiniband_switch_port_excessive_buffer_overrun_errors_total, "counter", "switch_buffer_overrun", "", "")
        or label_replace(infiniband_hca_port_receive_remote_physical_errors_total, "counter", "hca_remote_physical", "", "")
        or label_replace(infiniband_switch_port_receive_remote_physical_errors_total, "counter", "switch_remote_physical", "", "")

    - record: infiniband:link_failing_total
      expr: |
        label_replace(infiniband_hca_port_link_downed_total, "counter", "hca_link_downed", "", "")
        or label_replace(infiniband_switch_port_link_downed_total, "counter", "switch_link_downed", "", "")
        or label_replace(infiniband_hca_port_local_link_integrity_errors_total, "counter", "hca_link_integrity", "", "")
        or label_replace(infiniband_switch_port_local_link_integrity_errors_total, "counter", "switch_link_integrity", "", "")

    - record: infiniband:traffic_loss_total
      expr: |
        label_replace(infiniband_hca_port_transmit_discards_total, "counter", "hca_transmit_discards", "", "")
        or label_replace(infiniband_switch_port_transmit_discards_total, "counter", "switch_transmit_discards", "", "")
        or label_replace(infiniband_hca_port_transmit_constraint_errors_total, "counter", "hca_transmit_constraint", "", "")
        or label_replace(infiniband_switch_port_transmit_constraint_errors_total, "counter", "switch_transmit_constraint", "", "")
        or label_replace(infiniband_hca_port_receive_constraint_errors_total, "counter", "hca_receive_constraint", "", "")
        or label_replace(infiniband_switch_port_receive_constraint_errors_total, "counter", "switch_receive_constraint", "", "")

    # Pre-computed 5m throughput/congestion rates for the infiniband Grafana
    # dashboard (TRIX-513): rate once over the raw counters, HA-deduped via
    # max, hostname/switch joined - keeps panel queries cheap on large
    # clusters.
    - record: infiniband:hca_transmit_bytes:rate5m
      expr: |
        max by (guid, port) (rate(infiniband_hca_port_transmit_data_bytes_total[5m]))
        * on (guid) group_left (hostname, hca) infiniband:hca_hostname:map

    - record: infiniband:hca_receive_bytes:rate5m
      expr: |
        max by (guid, port) (rate(infiniband_hca_port_receive_data_bytes_total[5m]))
        * on (guid) group_left (hostname, hca) infiniband:hca_hostname:map

    - record: infiniband:node_transmit_bytes:rate5m
      expr: sum by (hostname) (infiniband:hca_transmit_bytes:rate5m)

    - record: infiniband:node_receive_bytes:rate5m
      expr: sum by (hostname) (infiniband:hca_receive_bytes:rate5m)

    - record: infiniband:switch_port_transmit_bytes:rate5m
      expr: |
        max by (guid, port) (rate(infiniband_switch_port_transmit_data_bytes_total[5m]))
        * on (guid) group_left (switch) max by (guid, switch) (infiniband_switch_info)

    - record: infiniband:switch_port_transmit_wait:rate5m
      expr: |
        max by (guid, port) (rate(infiniband_switch_port_transmit_wait_total[5m]))
        * on (guid) group_left (switch) max by (guid, switch) (infiniband_switch_info)
