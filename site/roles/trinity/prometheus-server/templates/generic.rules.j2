{{ ansible_managed | comment }}

groups:
- name: trinityx
  rules:

  - alert: ExporterDown
    expr: 'up == 0'
    labels:
      severity: info
      category: generic
    annotations:
      description: '{% raw %}Exporter {{$labels.exporter}} down{% endraw %}'

  - alert: ControllerServerDown
    expr: 'max by(hostname, luna_group) (up{job="luna_controllers"}) == 0'
    labels:
      severity: critical
      category: generic
    annotations:
      description: '{% raw %}Controller server down or unreachable{% endraw %}'

  - alert: ServerDown
    expr: 'max by(hostname, luna_group) (up{job="luna_nodes"}) == 0'
    labels:
      severity: warning
      category: generic
    annotations:
      description: '{% raw %}Server down or unreachable{% endraw %}'



  - alert: MultipleServer10PercentDown
    expr: 'avg(max by(hostname, luna_group) (up{job="luna_nodes"})) < 0.9'
    labels:
      severity: warning
      category: generic
    annotations:
      description: '{% raw %}More of 10% of the nodes have been down{% endraw %}'

  - alert: MultipleServer20PercentDown
    expr: 'avg(max by(hostname, luna_group) (up{job="luna_nodes"})) < 0.8'
    labels:
      severity: danger
      category: generic
    annotations:
      description: '{% raw %}More of 20% of the nodes have been down{% endraw %}'

  - alert: MultipleServer50PercentDown
    expr: 'avg(max by(hostname, luna_group) (up{job="luna_nodes"})) < 0.5'
    labels:
      severity: critical
      category: generic
    annotations:
      description: '{% raw %}More of 50% of the nodes have been down{% endraw %}'



  - alert: HighSystemTemperatureAbove70c
    expr: 'ipmi_temperature_celsius{name=~"[Ss]ystem.*[Tt]emp"} > 70'
    for: 15m
    labels:
      severity: danger
      category: generic
    annotations:
      description: '{% raw %}System temperature detected by BMC board is above 70C (current value: {{ $value }}C){% endraw %}'

  - alert: HighCPUTemperatureAbove90c
    expr: 'ipmi_temperature_celsius{name=~"[Cc][Pp][Uu].*[Tt]emp"} > 90'
    for: 15m
    labels:
      severity: danger
      category: generic
    annotations:
      description: '{% raw %}CPU temperature detected by BMC board is above 90C (current value: {{ $value }}C){% endraw %}'



  - alert: ProcessorFaultOnNode
    expr: 'ipmi_sensor_state{type="Processor", job="luna_nodes"} > 0'
    labels:
      severity: warning
      category: generic
      nhc: false
    annotations:
      description: '{% raw %}Processor fault detected by BMC board{% endraw %}'

  - alert: ProcessorFaultOnController
    expr: 'ipmi_sensor_state{type="Processor", job="luna_controllers"} > 0'
    labels:
      severity: critical
      category: generic
    annotations:
      description: '{% raw %}Processor fault detected by BMC board{% endraw %}'

  - alert: PowerSupplyFaultOnNode
    expr: 'ipmi_sensor_state{type="Power Supply", job="luna_nodes"} > 0'
    labels:
      severity: warning
      category: generic
    annotations:
      description: '{% raw %}Power Supply fault detected by BMC board{% endraw %}'

  - alert: PowerSupplyFaultOnController
    expr: 'ipmi_sensor_state{type="Power Supply", job="luna_controllers"} > 0'
    labels:
      severity: critical
      category: generic
    annotations:
      description: '{% raw %}Power Supply fault detected by BMC board{% endraw %}'



  - alert: LocalFilesystemFull90PercentOnController
    expr: 'node_filesystem_avail_bytes{job="luna_controllers", fstype=~"xfs|ext2|ext3|ext4|zfs|ntfs|reiserfs|ufs|vfat"} / node_filesystem_size_bytes{job="luna_controllers", fstype=~"xfs|ext2|ext3|ext4|zfs|ntfs|reiserfs|ufs|vfat"} < 0.1'
    labels:
      severity: warning
      category: generic
    annotations:
      description: '{% raw %}Filesystem {{$labels.mountpoint}} has less than 10% of capacity available {% endraw %}'

  - alert: LocalFilesystemFull95PercentOnController
    expr: 'node_filesystem_avail_bytes{job="luna_controllers", fstype=~"xfs|ext2|ext3|ext4|zfs|ntfs|reiserfs|ufs|vfat"} / node_filesystem_size_bytes{job="luna_controllers", fstype=~"xfs|ext2|ext3|ext4|zfs|ntfs|reiserfs|ufs|vfat"} < 0.05'
    labels:
      severity: danger
      category: generic
    annotations:
      description: '{% raw %}Filesystem {{$labels.mountpoint}} has less than 5% of capacity available {% endraw %}'

  - alert: LocalFilesystemFull97PercentOnController
    expr: 'node_filesystem_avail_bytes{job="luna_controllers", fstype=~"xfs|ext2|ext3|ext4|zfs|ntfs|reiserfs|ufs|vfat"} / node_filesystem_size_bytes{job="luna_controllers", fstype=~"xfs|ext2|ext3|ext4|zfs|ntfs|reiserfs|ufs|vfat"} < 0.03'
    labels:
      severity: critical
      category: generic
    annotations:
      description: '{% raw %}Filesystem {{$labels.mountpoint}} has less than 3% of capacity available {% endraw %}'


  - alert: HighCpuLoad50PercentOnController
    expr: '(node_load5{job="luna_controllers"}/count(node_cpu_seconds_total{mode="idle", job="luna_controllers"}) without (cpu,mode)) > 0.5'
    for: 1h
    labels:
      severity: warning
      category: generic
    annotations:
      description: '{% raw %}High CPU usage on controller for more than 1h{% endraw %}'

  - alert: HighCpuLoad90PercentOnController
    expr: '(node_load5{job="luna_controllers"}/count(node_cpu_seconds_total{mode="idle", job="luna_controllers"}) without (cpu,mode)) > 0.9'
    for: 1h
    labels:
      severity: danger
      category: generic
    annotations:
      description: '{% raw %}High CPU usage on controller for more than 1h{% endraw %}'

  - alert: HighCpuLoad100PercentOnController
    expr: '(node_load5{job="luna_controllers"}/count(node_cpu_seconds_total{mode="idle", job="luna_controllers"}) without (cpu,mode)) > 1'
    for: 1h
    labels:
      severity: critical
      category: generic
    annotations:
      description: '{% raw %}High CPU usage on controller for more than 1h{% endraw %}'



  - alert: HighMemoryUsage75PercentOnController
    expr: '(node_memory_MemFree_bytes{job="luna_controllers"} + node_memory_Cached_bytes{job="luna_controllers"} + node_memory_Buffers_bytes{job="luna_controllers"}) / node_memory_MemTotal_bytes{job="luna_controllers"} < 0.25'
    for: 1h
    labels:
      severity: warning
      category: generic
    annotations:
      description: '{% raw %}High memory usage on controller for more than 1h{% endraw %}'

  - alert: HighMemoryUsage95PercentOnController
    expr: '(node_memory_MemFree_bytes{job="luna_controllers"} + node_memory_Cached_bytes{job="luna_controllers"} + node_memory_Buffers_bytes{job="luna_controllers"}) / node_memory_MemTotal_bytes{job="luna_controllers"} < 0.05'
    for: 1h
    labels:
      severity: danger
      category: generic
    annotations:
      description: '{% raw %}High memory usage on controller for more than 1h {% endraw %}'



  - alert: SwappingOnController
    expr: '(node_memory_SwapCached_bytes{job="luna_controllers"} / node_memory_SwapTotal_bytes{job="luna_controllers"} > 0.5) or (node_memory_SwapCached_bytes{job="luna_controllers"} > 1e9)'
    for: 15m
    labels:
      severity: critical
      category: generic
    annotations:
      description: '{% raw %}Swap usage above 50% or 1GB {% endraw %}'
  
  - alert: SwappingOnNodes
    expr: '(node_memory_SwapCached_bytes{job="luna_nodes"} / node_memory_SwapTotal_bytes{job="luna_nodes"} > 0.5) or (node_memory_SwapCached_bytes{job="luna_nodes"} > 1e9)'
    for: 15m
    labels:
      severity: danger
      category: generic
    annotations:
      description: '{% raw %}Swap usage above 50% or 1GB{% endraw %}'



  - alert: ClockSkewDetected
    expr: "((node_timex_offset_seconds > 1) or (node_timex_offset_seconds < -1)) > 0"
    labels:
      severity: warning
      category: generic
    annotations:
      description: '{% raw %}Clock out of sync by more than 1s (current value: {{ $value }}){% endraw %}'

  - alert: ExcessiveTCPConnections
    expr: 'node_netstat_Tcp_CurrEstab > 1000'
    labels:
      severity: warning
      category: generic
    annotations:
      description: '{% raw %}Server has more than 1000 established TCP connections (current value: {{ $value }}){% endraw %}'

  - alert: Failover
    expr: '(max by (node) (ha_cluster_pacemaker_resources{resource="trinity-ip", status="active"})) unless on (node) (max by (node) (ha_cluster_pacemaker_resources{resource="trinity-ip", status="active"} offset 5m))'
    labels:
      severity: critical
      category: generic
    annotations:
      description: >
        {% raw %}The floating IP "trinity-ip" has changed its host node compared to 5 minutes ago. (current host: {{ $labels.node }}).{% endraw %}


  # {% raw %}Everything from here to the end of the file is literal: the {{ }}
  # below is Prometheus's own templating, fenced off so Ansible leaves it
  # alone. That keeps this section valid rules text on its own, so it can be
  # loaded straight into alertx or a rules file without being rendered first.
  # Do not put Ansible variables inside the fence - they would survive into
  # the output and Prometheus rejects the whole file, not just the rule.
  - alert: ECCCorrectableWarning
    expr: 'increase(node_edac_correctable_errors_total[1h]) >= 10'
    for: 10m
    labels:
      severity: warning
      category: generic
    annotations:
      description: >
        The node has recorded at least 10 correctable ECC memory errors during the last 1 hour.
        Correctable ECC errors were corrected by the memory subsystem but may indicate degrading
        memory hardware. Current count in the last 1 hour: {{ $value }}.

  - alert: ECCCorrectableCritical
    expr: 'increase(node_edac_correctable_errors_total[1h]) >= 100'
    for: 10m
    labels:
      severity: critical
      category: generic
    annotations:
      description: >
        The node has recorded at least 100 correctable ECC memory errors during the last 1 hour.
        This may indicate failing memory hardware and should be investigated. Current count in
        the last 1 hour: {{ $value }}.

  - alert: ECCUncorrectableWarning
    expr: 'increase(node_edac_uncorrectable_errors_total[1h]) >= 10'
    for: 5m
    labels:
      severity: warning
      category: generic
    annotations:
      description: >
        The node has recorded at least 10 uncorrectable ECC memory errors during the last 1 hour.
        Uncorrectable ECC errors cannot be repaired by the memory subsystem and may affect
        application stability or data integrity. Current count in the last 1 hour: {{ $value }}.

  - alert: ECCUncorrectableCritical
    expr: 'increase(node_edac_uncorrectable_errors_total[1h]) >= 50'
    for: 5m
    labels:
      severity: critical
      category: generic
    annotations:
      description: >
        The node has recorded at least 50 uncorrectable ECC memory errors during the last 1 hour.
        Multiple uncorrectable memory errors strongly indicate failing memory hardware and the node
        should be investigated immediately. Current count in the last 1 hour: {{ $value }}.


  # Infiniband fabric error detection (TRIX-1655), three rules by impact:
  # - InfinibandLinkDegraded (warning): early physical-layer degradation
  # - InfinibandLinkFailing (danger): hardware that needs replacement
  # - InfinibandTrafficLoss (warning): packets being dropped, jobs affected
  # Counters only carry {guid, port}; hostname is joined in from the
  # infiniband:*:map recording rules (see recording.rules.j2), which extract
  # it from the ibnetdiscover NodeDescription. Each rule covers both ends of
  # a link: HCA ports match the first join, switch ports the second, where
  # hostname is the node connected to that port. The infiniband:*_total
  # metrics (recording.rules.j2) union the raw counters of each class; the
  # inner sum combines them per port, the outer max dedupes the two
  # controllers scanning the same fabric in HA.

  - alert: InfinibandLinkDegraded
    expr: |
      ( ( max by (guid, port) (sum by (guid, port, instance) (increase(
            infiniband:link_degraded_total[1h])))
          > 100 )
        * on (guid) group_left (hostname, hca) infiniband:hca_hostname:map )
      or
      ( ( max by (guid, port) (sum by (guid, port, instance) (increase(
            infiniband:link_degraded_total[1h])))
          > 100 )
        * on (guid, port) group_left (switch, uplink, hostname) infiniband:switch_port_peer:map )
    labels:
      severity: warning
      category: generic
    annotations:
      description: >
        Infiniband link degrading on {{ $labels.hostname }}
        ({{ $labels.hca }}{{ $labels.switch }} port {{ $labels.port }}):
        {{ $value | printf "%.0f" }} link errors (symbol, receive, link recovery,
        buffer overrun, remote physical) in the last 1 hour. Check cable, connector and
        transceiver.

  - alert: InfinibandLinkFailing
    expr: |
      ( ( max by (guid, port) (sum by (guid, port, instance) (increase(
            infiniband:link_failing_total[1h])))
          > 2 )
        * on (guid) group_left (hostname, hca) infiniband:hca_hostname:map )
      or
      ( ( max by (guid, port) (sum by (guid, port, instance) (increase(
            infiniband:link_failing_total[1h])))
          > 2 )
        * on (guid, port) group_left (switch, uplink, hostname) infiniband:switch_port_peer:map )
    labels:
      severity: danger
      category: generic
    annotations:
      description: >
        Infiniband link failing on {{ $labels.hostname }}
        ({{ $labels.hca }}{{ $labels.switch }} port {{ $labels.port }}):
        {{ $value | printf "%.0f" }} link down or integrity errors in the last 1 hour
        (more than expected from a reboot). Failing cable, connector or port - replace.

  # The last branch keeps the alert alive for switch ports missing from the
  # current topology: a dead peer drops out of ibnetdiscover, and that is
  # exactly when transmit discards fire. Such alerts carry no hostname.
  - alert: InfinibandTrafficLoss
    expr: |
      ( ( max by (guid, port) (sum by (guid, port, instance) (increase(
            infiniband:traffic_loss_total[15m])))
          > 0 )
        * on (guid) group_left (hostname, hca) infiniband:hca_hostname:map )
      or
      ( ( max by (guid, port) (sum by (guid, port, instance) (increase(
            infiniband:traffic_loss_total[15m])))
          > 0 )
        * on (guid, port) group_left (switch, uplink, hostname) infiniband:switch_port_peer:map )
      or
      ( ( max by (guid, port) (sum by (guid, port, instance) (increase(
            infiniband:traffic_loss_total[15m])))
          > 0 )
        unless on (guid) infiniband:hca_hostname:map
        unless on (guid, port) infiniband:switch_port_peer:map )
    labels:
      severity: warning
      category: generic
    annotations:
      description: >
        Infiniband traffic loss on {{ $labels.hostname }}
        ({{ $labels.hca }}{{ $labels.switch }} port {{ $labels.port }}):
        {{ $value | printf "%.0f" }} discarded or rejected packets in the last 15
        minutes. Running jobs are affected - congestion, unreachable peer or partition
        misconfiguration.
  # {% endraw %} end of the literal Prometheus templating block
